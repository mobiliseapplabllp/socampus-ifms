<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.socampuseng.mbl.location</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SoCampus Service</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>4.2.7</string>
	<key>CFBundleVersion</key>
	<string>427</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict/>
	<key>NSCameraUsageDescription</key>
	<string>SoCampus uses the camera so you can photograph equipment and site conditions as evidence while filling a checklist or raising a ticket, and to scan asset QR codes.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>SoCampus records your location in the background during your shift so site visits and completed jobs are logged against the correct location even when the app is not open.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SoCampus records your location when you check in, scan an asset or submit a checklist, to confirm the work was carried out at the assigned site.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SoCampus uses the microphone so you can dictate checklist answers and remarks by voice instead of typing while working on site.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SoCampus saves the inspection photos you capture into your photo library so you keep your own copy of the evidence you submitted.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SoCampus lets you attach photos from your library as evidence to checklists, service reports and tickets.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>SoCampus converts your recorded speech into text so your spoken checklist answers and remarks are filled into the report automatically.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
